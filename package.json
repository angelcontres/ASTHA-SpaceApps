{
  "name": "astha-crew-pwa",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "ASTHA (Autonomous Space Telemetry & Health Analytics) — Zero-WAN Crew PWA Shell (Svelte 5 + Deterministic Web Workers)",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/generate-sw-manifest.mjs && node scripts/check-bundle-budget.mjs",
    "preview": "vite preview --port 4173",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit && tsc -p ./tsconfig.tests.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "verify": "npm run check && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "svelte": "^5.25.0",
    "three": "^0.174.0",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@types/node": "^26.6.6",
    "@types/three": "^0.174.0",
    "eslint": "^9.22.0",
    "eslint-plugin-svelte": "^3.2.0",
    "globals": "^16.0.0",
    "svelte-check": "^4.1.5",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1",
    "vite": "^6.2.2",
    "vitest": "^3.0.9"
  }
}
