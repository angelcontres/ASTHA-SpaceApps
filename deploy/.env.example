# Image tag deployed on AWS EC2 / Lightsail (populated automatically by CI/CD)
ASTHA_IMAGE=ghcr.io/angelcontres/astha-spaceapps-pwa:latest

# Localhost loopback binding when Caddy handles ports 80/443; set 0.0.0.0:80 for HTTP-only testing
ASTHA_BIND_ADDR=127.0.0.1
ASTHA_HTTP_PORT=8080

# Custom domain pointed via DNS A-record to your AWS EC2/Lightsail public IP.
# Enables automatic HTTPS (required for Web Crypto Ed25519 + Service Worker on public domains).
ASTHA_DOMAIN=astha.example.com
